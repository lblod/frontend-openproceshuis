<AuTooltip @placement="right" as |tooltip|>
  <AuButton
    @icon="circle-question"
    @hideText={{true}}
    @skin="link"
    @size="large"
    class="color--gray"
    {{tooltip.target}}
  />
  <tooltip.Content>
    <p>Gevoelige gegevens die extra bescherming vereisen bijvoorbeeld medische
      gegevens, religieuze overtuiging, etnische achtergrond, biometrische
      gegevens.</p>
  </tooltip.Content>
</AuTooltip>