<AuTooltip @placement="right" as |tooltip|>
  <AuButton
    @icon="circle-question"
    @hideText={{true}}
    @skin="link"
    @size="large"
    class="color--gray"
    {{tooltip.target}}
  />
  <tooltip.Content>
    <p>Gegevens die direct of indirect een persoon identificeren bijvoorbeeld
      geboortedatum, foto, naam, thuisadres.</p>
  </tooltip.Content>
</AuTooltip>