<AuTooltip @placement="right" as |tooltip|>
  <AuButton
    @icon="circle-question"
    @hideText={{true}}
    @skin="link"
    @size="large"
    class="color--gray"
    {{tooltip.target}}
  />
  <tooltip.Content>
    <p>Gegevens waarmee een persoon professioneel kan worden bereikt
      bijvoorbeeld professioneel telefoonnummer/e-mailadres, postadres van de
      organisatie.</p>
  </tooltip.Content>
</AuTooltip>