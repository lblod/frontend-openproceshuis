{{! template-lint-disable no-invalid-interactive }}
<td class="au-u-1-2 {{this.classForFirstColumn}}">
  <span class={{this.subRowButtonClass}}>
    <AuButton
      @skin="naked"
      @icon={{this.iconSubRowOpen}}
      {{on "click" this.openCloseSubRows}}
    />
  </span>
  {{#if @isViewOnly}}
    {{@diagram.diagramFile.name}}
  {{else}}
    <AuButton
      class={{if @mainDiagram "au-u-margin-left" ""}}
      @skin="link"
      @wrap={{true}}
      {{on "click" (fn @onDiagramFileSelected @diagram.diagramFile)}}
    >
      {{@diagram.diagramFile.name}}
    </AuButton>
  {{/if}}
</td>
<td>{{date-format @diagram.diagramFile.created true}}</td>
<td>{{file-size-format @diagram.diagramFile.size}}</td>
<td>
  {{#if @mainDiagram}}
    <AuPill @skin="info" @size="small">
      <Shared::TextCompare
        @current="{{@mainDiagram.position}}.{{@diagram.position}}"
        @old={{@versionedDiagram._comparePosition}}
        @enableHighlighting={{if @versionedDiagram true}}
      >
        Subdiagram
        {{@mainDiagram.position}}.{{@diagram.position}}
      </Shared::TextCompare>
    </AuPill>
  {{else}}
    <AuPill @skin="success" @size="small">
      <Shared::TextCompare
        @current="{{@diagram.position}}"
        @old={{@versionedDiagram._comparePosition}}
        @enableHighlighting={{if @versionedDiagram true}}
      >
        Hoofddiagram
        {{@diagram.position}}
      </Shared::TextCompare>
    </AuPill>
  {{/if}}
</td>
<td>
  <AuButton @skin="naked" {{on "click" @onFileDownload}}>Download</AuButton>
</td>
{{#unless @isViewOnly}}
  <td>
    <AuLink
      @route="diagrams.diagram.index"
      @skin="button-naked"
      @model={{@diagram.id}}
      @query={{hash
        previousRouteTitle=@process.title
        previousRouteModelId=@process.id
        previousRouteName=(or @processRouteName "processes.process")
      }}
    >
      Detail
    </AuLink>
  </td>
{{/unless}}
{{#if this.isSubRowOpen}}
  {{yield}}
{{/if}}