<AuModal
  @modalOpen={{true}}
  @closable={{true}}
  @closeModal={{this.onCloseModal}}
>
  <:title>
    {{this.activeStep.title}}
  </:title>
  <:body>
    {{#if this.loadingMessage}}
      <div
        class="au-u-flex au-u-flex--center au-u-flex--vertical-center au-u-flex--column"
      >
        {{#if this.showSuccessMessage}}
          <span class="wizard-success-icon">
            <AuIcon @icon="circle-check" @size="large" />
          </span>
          <p class="au-u-margin-top-small">{{this.loadingMessage}}</p>
        {{else}}
          <Shared::Loader @message={{this.loadingMessage}} />
        {{/if}}
      </div>
    {{/if}}
    {{#unless this.executeCurrentStepActionAsTask.isRunning}}
      {{#if (eq this.activeStep.step this.wizardStep.SELECT_ACTION)}}
        <Wizard::Actions
          @onQuickActionSelected={{this.onQuickActionSelected}}
          @disabledActions={{this.disabledActions}}
          @onManageDiagrams={{this.manageDiagrams}}
        />
      {{/if}}
      {{#if (eq this.activeStep.step this.wizardStep.UPLOAD_FILES)}}
        <div class="au-u-height-full">
          <Wizard::AddDiagrams
            @onFileWrappersChanged={{this.addFileToUploadedList}}
            @onLibraryFilesChanged={{this.addLibraryFilesToList}}
          />
        </div>
      {{/if}}
      {{#if (eq this.activeStep.step this.wizardStep.SELECT_MAIN_PROCESS)}}
        {{#if this.areFilesCreated}}
          <AuLabel @required={{true}} class="au-u-margin-top">Selecteer het
            hoofddiagram</AuLabel>
          <PowerSelect
            @searchEnabled={{true}}
            @searchField="name"
            @loadingMessage="Aan het laden..."
            @noMatchesMessage="Geen bestanden gevonden"
            @options={{this.sortedFiles}}
            @selected={{this.mainProcessFile}}
            @onChange={{this.setMainProcessFile}}
            @disabled={{this.isSelectMainDiagramDisabled}}
            @allowClear={{false}}
            as |file|
          >
            {{file.name}}
          </PowerSelect>
          {{#if this.isSelectMainDiagramDisabled}}
            <AuHelpText @warning={{true}}>
              Je hebt één diagram geüpload. Dit is automatisch het hoofddiagram.
            </AuHelpText>
          {{/if}}
        {{/if}}
      {{/if}}
    {{/unless}}
  </:body>
  <:footer>
    <AuToolbar as |Group|>
      <Group>
        {{#if (eq this.activeStep.step this.wizardStep.UPLOAD_FILES)}}
          <p class="color--warning">Maximum aantal bestanden is
            {{this.maxUploadAmount}}</p>
        {{/if}}
      </Group>
      <Group>
        {{#if this.activeStep.canCancelStep}}
          <AuButton
            class="border-radius"
            @skin="secondary"
            {{on "click" this.restoreAndCloseWizard}}
            @disabled={{not this.activeStep.canCancelStep}}
          >
            Annuleer
          </AuButton>
        {{/if}}
        {{#if this.activeStep.nextStepButtonLabel}}
          <AuButton
            class="border-radius"
            @loading={{this.executeCurrentStepActionAsTask.isRunning}}
            {{on "click" this.nextStep}}
            @disabled={{not this.activeStep.canGoToNextStep}}
          >
            {{this.activeStep.nextStepButtonLabel}}
          </AuButton>
        {{/if}}
      </Group>
    </AuToolbar>
  </:footer>
</AuModal>