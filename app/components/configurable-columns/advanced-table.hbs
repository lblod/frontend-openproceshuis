<div
  class="au-c-advanced-table
    {{if this.hasStickyFirstColumn 'au-c-advanced-table--sticky-first-column'}}"
>
  <AuDataTable
    @content={{this.model}}
    @isLoading={{this.isLoading}}
    @page={{this.page}}
    @size={{this.size}}
    as |t|
  >
    <t.content class="au-c-data-table__table--small" as |c|>
      <c.header>
        {{#each this.columns key="key" as |column|}}
          {{#if column.isSortable}}
            <AuDataTableThSortable
              @field={{or column.resourcesSortPath column.key}}
              @label={{column.label}}
              @currentSorting={{this.sort}}
            />
          {{else}}
            <th>{{column.label}}</th>
          {{/if}}
        {{/each}}
      </c.header>
      {{#if this.hasMessage}}
        {{yield to="message"}}
      {{else}}
        <c.body as |row|>
          {{#each this.columns key="key" as |column index|}}
            {{#if (eq index 0)}}
              <th scope="row">{{yield row column to="cell"}}</th>
            {{else}}
              <td>{{yield row column to="cell"}}</td>
            {{/if}}
          {{/each}}
        </c.body>
      {{/if}}
    </t.content>
  </AuDataTable>
</div>