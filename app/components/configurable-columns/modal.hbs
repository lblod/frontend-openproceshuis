<AuModal
  @modalOpen={{@isModalOpen}}
  @closable={{true}}
  @closeModal={{this.cancelConfiguration}}
  class="cc-modal"
>
  <:title>Kolommen aanpassen</:title>
  <:body>
    <p class="au-u-margin-bottom">Kies de tabel kolommen die je wil zien in de
      procesbibliotheek, en hun volgorde.</p>
    <div class="au-o-grid au-o-grid--small cc-columns-grid">
      <div class="au-o-grid__item au-u-1-2@medium">
        <div class="cc-columns-container au-u-padding-small">
          <ConfigurableColumns::SelectColumns @context={{@context}} />
        </div>
      </div>
      <div class="au-o-grid__item au-u-1-2@medium">
        <div class="cc-columns-container au-u-padding-small">
          <ConfigurableColumns::ManageColumns @context={{@context}} />
        </div>
      </div>
    </div>
  </:body>
  <:footer>
    <div class="au-u-flex au-u-flex--end">
      <AuButton
        @skin="naked"
        {{on "click" this.cancelConfiguration}}
      >Annuleren</AuButton>
      <AuButton {{on "click" this.saveConfiguration}}>Bewaren</AuButton>
    </div>
  </:footer>
</AuModal>