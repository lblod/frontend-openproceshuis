<p class="au-u-medium">Geselecteerde kolommen</p>
<AuHelpText>Versleep de kolommen om de volgorde aan te passen.</AuHelpText>
<div class="au-u-flex au-u-flex--end au-u-margin-top-small">
  <AuButton @skin="link" @icon="undo">Kolommen herstellen</AuButton>
</div>
<AuAlert
  @title={{null}}
  @skin="warning"
  @icon="alert-triangle"
  @size="small"
  @closable={{false}}
>
  <p>Veel kolommen selecteren kan er voor zorgen dat sommige kolommen uit beeld
    vallen.</p>
</AuAlert>

<AuHeading @level="3" @skin="6" class="au-u-margin-bottom-tiny">Vaste kolommen</AuHeading>
<AuHelpText>Vaste kolommen kunnen niet aangepast worden.</AuHelpText>
{{#each this.fieldService.fixedFields as |field|}}
  <div
    class="au-u-flex au-u-flex--vertical-center au-u-flex--spaced-tiny au-u-padding-tiny au-u-padding-left au-u-margin-bottom-tiny au-u-background-gray-200 cc-draggable-field-container"
  >
    <p>{{field.label}}</p>
    {{#if field.hintText}}
      <AuTooltip @placement="right" as |tooltip|>
        <AuButton
          @icon="circle-info"
          @hideText={{true}}
          @skin="link"
          class="color--gray"
          {{tooltip.target}}
        />
        <tooltip.Content>
          <p>{{field.hintText}}</p>
        </tooltip.Content>
      </AuTooltip>
    {{/if}}
  </div>
{{/each}}
<AuHeading @level="3" @skin="6" class="au-u-margin-bottom-tiny">Meescrollende kolommen</AuHeading>
{{#each this.fieldService.dynamicFields as |field|}}
  <div
    class="au-u-flex au-u-flex--vertical-center au-u-flex--spaced-tiny au-u-padding-tiny au-u-padding-left au-u-margin-bottom-tiny au-u-background-gray-200 cc-draggable-field-container"
  >
    <p>{{field.label}}</p>
    {{#if field.hintText}}
      <AuTooltip @placement="right" as |tooltip|>
        <AuButton
          @icon="circle-info"
          @hideText={{true}}
          @skin="link"
          class="color--gray"
          {{tooltip.target}}
        />
        <tooltip.Content>
          <p>{{field.hintText}}</p>
        </tooltip.Content>
      </AuTooltip>
    {{/if}}
  </div>
{{/each}}