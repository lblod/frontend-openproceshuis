<div class="au-o-grid au-o-grid--small">
  <div class="au-o-grid__item au-u-1-2">
    <AuTabs as |Tab|>
      <Tab>
        <AuLink @icon="download">Upload</AuLink>
      </Tab>
    </AuTabs>
    <File::Dropzone
      @title="Eén of meer BPMN/Visio bestanden selecteren"
      @helpTextDragDrop="Bestanden worden toegevoegd aan bibliotheek na selectie"
      @multiple={{true}}
      @accept=".bpmn,.vsdx"
      @onFileUploaded={{this.handleFileUpload}}
    />
  </div>
  <div class="au-o-grid__item au-u-1-2">
    <p>Geselecteerd
      <span class="au-u-muted">({{this.fileWrappers.length}})</span></p>
    <div class="c-file-list au-u-margin-top">
      {{#each this.fileWrappers as |file|}}
        <File::SlimCard
          @primaryName={{file.name}}
          @secondaryName={{file-size-format file.size}}
        >
          <:actions>
            <AuButton
              @skin="naked"
              @alert="true"
              @icon="bin"
              @hideText={{true}}
              aria-label="Verwijder {{file.name}}"
              {{on "click" (fn this.removeFileWrapper file)}}
            >
              Verwijder
            </AuButton>
          </:actions>
        </File::SlimCard>
      {{/each}}
    </div>
  </div>
</div>