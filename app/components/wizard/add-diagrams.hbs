<div class="au-o-grid au-o-grid--small">
  <div class="au-o-grid__item au-u-1-2">
    <div class="c-add-diagrams__tablist">
      <AuButton
        @skin="naked"
        class="c-add-diagrams__tab
          {{if (eq this.activeTab 'upload') 'c-add-diagrams__tab--active'}}"
        {{on "click" (fn this.setActiveTab "upload")}}
      >
        Uploaden
      </AuButton>
      <AuButton
        @skin="naked"
        class="c-add-diagrams__tab
          {{if (eq this.activeTab 'library') 'c-add-diagrams__tab--active'}}"
        {{on "click" (fn this.setActiveTab "library")}}
      >
        Uit bibliotheek
      </AuButton>
    </div>

    <div hidden={{not (eq this.activeTab "upload")}}>
      <File::Dropzone
        @title="Eén of meer BPMN/Visio bestanden selecteren"
        @helpTextDragDrop="Bestanden worden toegevoegd aan bibliotheek na selectie"
        @multiple={{true}}
        @accept=".bpmn,.vsdx"
        @onFileUploaded={{this.handleFileUpload}}
      />
    </div>

    <div hidden={{not (eq this.activeTab "library")}}>
      <File::LibrarySelection
        @onFileSelected={{this.addFileFromLibrary}}
        @disabledFiles={{this.files}}
      />
    </div>
  </div>

  <div class="au-o-grid__item au-u-1-2">
    <p>Geselecteerd
      <span class="au-u-muted">({{this.combinedFiles.length}})</span></p>
    <div class="c-file-list au-u-margin-top">
      {{#each this.combinedFiles as |file|}}
        <File::SlimCard
          @primaryName={{file.name}}
          @secondaryName={{file-size-format file.size}}
        >
          <:actions>
            {{#if (eq file._source "upload")}}
              <AuPill @skin="link" @size="small">Nieuw</AuPill>
            {{/if}}
            <AuButton
              @skin="naked"
              @alert="true"
              @icon="bin"
              @hideText={{true}}
              aria-label="Verwijder {{file.name}}"
              {{on "click" (fn this.removeFileWrapper file)}}
            >
              Verwijder
            </AuButton>
          </:actions>
        </File::SlimCard>
      {{/each}}
    </div>
  </div>
</div>