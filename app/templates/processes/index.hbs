<SidebarContainer>
  <:sidebar>
    <div class="au-c-sidebar">
      <div class="au-c-sidebar__content">
      </div>
    </div>
  </:sidebar>
  <:content>
    <AuToolbar @size="medium" @nowrap={{true}} as |Group|>
      <Group>
        <AuHeading>Processen</AuHeading>
      </Group>
      <Group class="au-u-flex au-u-flex--vertical-center">
        <AuLinkExternal
          @icon="book"
          href="https://abb-vlaanderen.gitbook.io/informatie-oph"
        >
          Handleiding
        </AuLinkExternal>
        <AuButton>Proces toevoegen</AuButton>
      </Group>
    </AuToolbar>
    <AuToolbar @size="small" @nowrap={{true}} @reverse={{true}} as |Group|>
      <Group>
        <AuButton
          @skin="link"
          @icon="gear"
          {{on "click" (fn (mut this.isConfigureColumnsOpen) true)}}
        >Kolommen aanpassen</AuButton>
      </Group>
    </AuToolbar>
  </:content>
</SidebarContainer>

<AuModal @modalOpen={{this.isConfigureColumnsOpen}} @closable={{false}} @size="large">
  <:title>Kolommen aanpassen</:title>
  <:body>
    <p class="au-u-margin-bottom">Kies de table kolommen die je wilt zien in de
      processenbibliotheek, en hun volgorde.</p>
    <div class="au-o-grid au-o-grid--small">
      <div class="au-o-grid__item au-u-1-2@medium">
        <div class="cc-columns-container au-u-padding-small">
          <ConfigurableColumns::SelectColumns />
        </div>
      </div>
      <div class="au-o-grid__item au-u-1-2@medium">
        <div class="cc-columns-container au-u-padding-small">
          <ConfigurableColumns::ManageColumns />
        </div>
      </div>
    </div>
  </:body>
  <:footer>
    <div class="au-u-flex au-u-flex--end">
      <AuButton
        @skin="naked"
        {{on "click" (fn (mut this.isConfigureColumnsOpen) false)}}
      >Annuleer</AuButton>
      <AuButton>Bewaren</AuButton>
    </div>
  </:footer>
</AuModal>